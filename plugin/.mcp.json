{
  "mcpServers": {
    "attelier": {
      "type": "stdio",
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/mcp/bin/attelier-mcp.js"],
      "env": {
        "ATTELIER_API_URL": "${ATTELIER_API_URL:-https://api.attelier.ai}",
        "ATTELIER_API_TOKEN": "${ATTELIER_API_TOKEN}"
      }
    }
  }
}
