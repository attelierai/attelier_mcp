{
  "name": "attelier-mcp",
  "version": "1.12.0",
  "private": true,
  "type": "module",
  "description": "Attelier's stdio MCP server. Exposes Atte's public tools to Claude Code, Codex and any MCP client.",
  "bin": {
    "attelier-mcp": "./bin/attelier-mcp.js"
  },
  "exports": {
    ".": {
      "types": "./src/server.ts",
      "default": "./dist/server.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "tsx --test src/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json"
  },
  "dependencies": {
    "@atte/kit": "workspace:*",
    "@attelier/motion": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "files": [
    "src",
    "dist",
    "bin",
    "skills",
    "!src/**/*.test.ts",
    "!dist/**/*.test.*",
    "INSTALL.md"
  ]
}
